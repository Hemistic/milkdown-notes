{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "packages/editor/src/**/*.ts",
    "apps/local/src/**/*.ts",
    "apps/local/src/**/*.tsx",
    "packages/sidebar/src/**/*.ts",
    "packages/sidebar/src/**/*.tsx",
    "examples/*.ts"
  ]
}

{
  "name": "milkdown-notes-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/editor",
    "packages/sidebar"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/build.mjs && node apps/local/server.mjs",
    "start": "node apps/local/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write packages/editor/src packages/sidebar/src apps/local examples scripts tests docs README.md",
    "format:check": "prettier --check packages/editor/src packages/sidebar/src apps/local examples scripts tests docs README.md"
  },
  "devDependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@lezer/highlight": "1.2.5",
    "@milkdown/components": "7.22.3",
    "@milkdown/core": "7.22.3",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/ctx": "7.22.3",
    "@milkdown/plugin-diff": "7.22.3",
    "@milkdown/plugin-slash": "7.22.3",
    "@milkdown/plugin-streaming": "7.22.3",
    "@milkdown/plugin-tooltip": "7.22.3",
    "@milkdown/preset-commonmark": "7.22.3",
    "@milkdown/preset-gfm": "7.22.3",
    "@milkdown/prose": "7.22.3",
    "@milkdown/utils": "7.22.3",
    "@types/katex": "0.16.8",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dompurify": "3.4.17",
    "esbuild": "0.28.0",
    "katex": "0.19.0",
    "lucide": "1.49.0",
    "marked": "18.1.0",
    "mermaid": "11.12.1",
    "micromark-util-chunked": "2.0.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-resolve-all": "2.0.1",
    "micromark-util-types": "2.0.3",
    "prettier": "3.9.10",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remark-math": "6.0.0",
    "typescript": "6.0.2",
    "unified": "11.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
